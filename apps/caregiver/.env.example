# Copy to .env and fill in. .env is gitignored: never commit it.
#
# Firebase web-app config, from Firebase console -> Project settings ->
# Your apps -> Web app. These identify the project; they are not secrets
# (security is the rules in contracts/), but they stay out of source.
#
# The owner's project (public config, for reference -- copy into .env):
#   EXPO_PUBLIC_FIREBASE_PROJECT_ID=speedy-district-509007-f0
#   EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=speedy-district-509007-f0.firebaseapp.com
#   EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=speedy-district-509007-f0.firebasestorage.app
#   EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=521033953948
#   EXPO_PUBLIC_FIREBASE_APP_ID=1:521033953948:web:56b56be78d994472e57359
#   (the API key is in the console, same page; no Analytics)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google sign-in on phones (web needs none of these: Firebase's popup).
# OAuth client IDs from Google Cloud console -> APIs & Services ->
# Credentials, in the same project. See README "Google sign-in".
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# The "Web client (auto created by Google Service)" one Firebase made.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# 1 = talk to the local emulators (auth 9193, firestore 8183,
# storage 9293) instead of the real project. Pair it with
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-saathi.
EXPO_PUBLIC_USE_EMULATORS=0
# Where the emulators are reachable from the app: 127.0.0.1 for web and
# the iOS simulator, 10.0.2.2 for the Android emulator, the laptop's LAN
# address for a real phone.
EXPO_PUBLIC_EMULATOR_HOST=127.0.0.1
