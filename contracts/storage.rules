rules_version = '2';

// Why this file exists: her voice clips and her memory file are the most
// private things Saathi keeps. Storage has its own rules language, so the
// Firestore rules don't protect these paths; this file applies the same
// membership (devices/{id}.deviceUid and .caregivers, read from Firestore)
// to the two Storage paths in the contract:
//
//   devices/{id}/audio/{turnId}.wav     her side of a turn
//   devices/{id}/memory/{ts}.sqlite3    a copy of the memory database
//
// Contested decisions (the option that lost, and why):
//   - Lost: custom auth claims (deviceId / device list in the token) so
//     Storage needn't read Firestore. Claims need the Admin SDK to set and
//     a token refresh to change, so a newly paired caregiver would wait
//     for their token to roll over. firestore.get() costs one read per
//     request and is always current.
//   - Lost: caregivers reading the memory copy. The app shows her turns
//     and reminders; the raw database is everything she has ever said and
//     what Saathi inferred from it, kept as a backup. Only the device
//     reads it back. (Firestore's "caregivers read the device" is a
//     ceiling, not a promise of every byte.)
//   - Lost: pinning contentType. The device uploads over REST and the
//     exact audio MIME string (audio/wav vs audio/x-wav) is a client
//     detail; the file name and a size cap carry the contract.

service firebase.storage {
  match /b/{bucket}/o {

    function deviceDoc(deviceId) {
      return firestore.get(/databases/(default)/documents/devices/$(deviceId));
    }

    function isDevice(deviceId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/devices/$(deviceId))
        && deviceDoc(deviceId).data.deviceUid == request.auth.uid;
    }

    function isCaregiver(deviceId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/devices/$(deviceId))
        && request.auth.uid in deviceDoc(deviceId).data.caregivers;
    }

    match /devices/{deviceId}/audio/{fileName} {
      allow read: if fileName.matches('[^/]+[.]wav')
        && (isDevice(deviceId) || isCaregiver(deviceId));
      allow create, update: if fileName.matches('[^/]+[.]wav')
        && isDevice(deviceId)
        && request.resource.size < 20 * 1024 * 1024;
      allow delete: if isDevice(deviceId);
    }

    match /devices/{deviceId}/memory/{fileName} {
      allow read, delete: if fileName.matches('[^/]+[.]sqlite3')
        && isDevice(deviceId);
      allow create, update: if fileName.matches('[^/]+[.]sqlite3')
        && isDevice(deviceId)
        && request.resource.size < 200 * 1024 * 1024;
    }

    // Everything else in the bucket is denied by default.
  }
}
