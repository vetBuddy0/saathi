{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saathi.invalid/contracts/reminder.schema.json",
  "title": "Reminder",
  "description": "devices/{id}/reminders/{rid}. A reminder a caregiver set. time is the device's local wall clock, HH:MM. date (YYYY-MM-DD) pins a one-off to a day; a one-off with no date means the next such time. createdBy is the creating caregiver's uid and never changes. The device may only switch active (and updatedAt).",
  "type": "object",
  "required": [
    "text",
    "time",
    "repeat",
    "active",
    "createdBy",
    "updatedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "time": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "repeat": {
      "enum": [
        "none",
        "daily",
        "weekdays",
        "weekly"
      ]
    },
    "active": {
      "type": "boolean"
    },
    "createdBy": {
      "type": "string",
      "minLength": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
