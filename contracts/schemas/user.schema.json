{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saathi.invalid/contracts/user.schema.json",
  "title": "User",
  "description": "users/{uid}. A caregiver's own profile: their name and the push tokens of their phones. Readable and writable only by that uid; Cloud Functions read it with admin rights to send push.",
  "type": "object",
  "required": [
    "name",
    "fcmTokens"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "fcmTokens": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
