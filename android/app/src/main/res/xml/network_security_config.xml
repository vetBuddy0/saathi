<?xml version="1.0" encoding="utf-8"?>
<!--
  The engine is plain http on the home network, at an address typed into
  the setup dialog, so cleartext to it has to be allowed. The brief asks
  for cleartext "only for private LAN ranges"; this file cannot say that.
  A <domain> entry matches one host name (or an exact IP literal) with an
  optional subdomain suffix - Android's config has no CIDR, so there is no
  way to write 192.168.0.0/16 here, and listing the one IP a household
  uses would make every household a rebuild. What lost: a false
  base-config with a hand-kept domain list.

  So the base config permits cleartext, and the private-range rule is
  enforced in code instead, at three points: EngineAddress.normalise()
  refuses to store an engine address that is not RFC 1918, link-local,
  loopback or a .local name, and the shell loads no cleartext URL it did
  not get from there; CleartextGuard (both WebViewClients'
  shouldInterceptRequest) answers any http:// sub-resource, frame or
  script a page asks for from a host off those ranges with an empty 403,
  since the main-frame rules never see those requests; and the setup
  dialog's "Test" follows no redirect, so a LAN address answering 302 to
  a public host is "not an answer", not a fetch. What the config *can*
  say is which public hosts never get cleartext: the watch page's own
  hosts are denied it here (found in review: the base config alone
  allowed an http:// youtube.com navigation, and the pane's host rule
  ignored the scheme), and WebViewYouTubePane refuses a non-https main
  frame on top.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">youtube.com</domain>
        <domain includeSubdomains="true">youtu.be</domain>
        <domain includeSubdomains="true">google.com</domain>
        <domain includeSubdomains="true">googlevideo.com</domain>
        <domain includeSubdomains="true">ggpht.com</domain>
        <domain includeSubdomains="true">ytimg.com</domain>
    </domain-config>
</network-security-config>
