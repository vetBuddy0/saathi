<?xml version="1.0" encoding="utf-8"?>
<!--
  Two panes side by side (face left, the watch page right, hidden until a
  browser-target play), and the push-to-talk button laid over the whole
  thing at bottom-left. The button is a child of the root, not of the face
  pane, so a fullscreen video that takes the face pane down to a corner
  does not take the button with it. The button's text is content - what
  it is for - never a status; nothing in this layout may say "Listening".
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <LinearLayout
        android:id="@+id/panes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/face_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <WebView
                android:id="@+id/face_web"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/youtube_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:visibility="gone">

            <WebView
                android:id="@+id/youtube_web"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </LinearLayout>

    <Button
        android:id="@+id/talk_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="24dp"
        android:minWidth="160dp"
        android:minHeight="160dp"
        android:text="@string/talk_button"
        android:textAllCaps="false"
        android:textSize="22sp" />

</FrameLayout>
