<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only: android:testOnly is what lets `adb shell dpm
  remove-active-admin` take the Device Owner off a tablet again (dpm
  refuses for any other admin, and the only other way is a factory reset).
  The README's instruction said remove-active-admin "works for a debug
  build"; it did not, because nothing set this flag -- Android Studio's Run
  button injects it, a command-line assembleDebug does not (found in
  review). The cost: a testOnly APK installs only with `adb install -t`,
  which the README now says. The release build is unchanged.

  The value is a manifest placeholder filled from the Gradle property
  `saathi.testOnly` (app/build.gradle.kts), "true" unless a build says
  otherwise: the phone's own installer refuses a testOnly APK, and the
  APK GitHub Actions builds on a push is installed from the phone, so
  that build passes false. A manual run of the workflow can ask for the
  testOnly one again, for a tablet.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:testOnly="${saathiTestOnly}" />
</manifest>
